<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EcoGrocer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorPrimaryDark">@color/green_primary_dark</item>
        <item name="colorAccent">@color/green_accent</item>
        <item name="colorOnPrimary">@color/green_on_primary</item>
        <item name="colorSecondary">@color/green_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/background_white</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background_primary</item>
        <item name="android:statusBarColor">@color/green_primary</item>
        <item name="android:windowBackground">@color/background_primary</item>
    </style>

    <style name="Theme.EcoGrocer" parent="Base.Theme.EcoGrocer" />

    <!-- Button Styles -->
    <style name="EcoButton" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/green_primary</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_lg</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">20dp</item>
    </style>

    <style name="EcoButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/green_primary</item>
        <item name="strokeColor">@color/green_primary</item>
        <item name="cornerRadius">@dimen/button_corner</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/text_lg</item>
    </style>

    <!-- Input Style -->
    <style name="EcoTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/input_corner</item>
        <item name="boxCornerRadiusTopEnd">@dimen/input_corner</item>
        <item name="boxCornerRadiusBottomStart">@dimen/input_corner</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/input_corner</item>
        <item name="boxStrokeColor">@color/green_primary</item>
        <item name="hintTextColor">@color/green_primary</item>
    </style>

    <!-- Card Style -->
    <style name="EcoCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/card_corner</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/background_card</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.EcoGrocer.Splash" parent="Theme.EcoGrocer">
        <item name="android:windowBackground">@color/green_primary</item>
        <item name="android:statusBarColor">@color/green_primary</item>
    </style>

    <!-- Auth Theme -->
    <style name="Theme.EcoGrocer.Auth" parent="Theme.EcoGrocer">
        <item name="android:windowBackground">@color/background_white</item>
    </style>
</resources>